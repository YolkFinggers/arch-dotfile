# Daily 08:00 City Mode. Replaces the old hypridle-schedule.timer (hypridle is masked).
# WantedBy=timers.target, not graphical-session.target, because graphical-session.target
# is never activated on this setup. No Persistent=: a missed 08:00 (machine off/asleep)
# is not caught up later in the day.
[Unit]
Description=Daily Neon Rain morning City Mode (08:00)

[Timer]
OnCalendar=*-*-* 08:00:00
Persistent=false

[Install]
WantedBy=timers.target
