# Fired by city-morning.timer at 08:00. Opens City Mode on the running Neon Rain wallpaper
# (idempotent: never closes an open City). Skips cleanly when Hyprland or the wallpaper is
# not running or the session is locked. Never starts the wallpaper, locks, unlocks or
# powers displays off; see scripts/city-morning.
[Unit]
Description=Neon Rain morning City Mode (open only)
Documentation=file:%h/.dotfiles/neon-rain/systemd/README.md

[Service]
Type=oneshot
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.dotfiles/neon-rain/scripts/city-morning
TimeoutStartSec=30
